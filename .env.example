# Template only: copy to .env (git-ignored) and fill in locally.
# Never put credentials in this file or anywhere in Git.

# AWS: name a profile set up with the AWS CLI; keys stay in ~/.aws, not here.
AWS_PROFILE=
# Fixed region for the hackathon account.
AWS_DEFAULT_REGION=us-west-2
# Bedrock model for all agents, as listed in the Bedrock console for us-west-2.
CLEAR_BEDROCK_MODEL_ID=

# SAP AI Core: values from the team's service key. Used for SAP-RPT-1.6.
SAP_AICORE_AUTH_URL=
SAP_AICORE_CLIENT_ID=
SAP_AICORE_CLIENT_SECRET=
SAP_AICORE_API_URL=
SAP_AICORE_RESOURCE_GROUP=default
SAP_RPT_DEPLOYMENT_ID=

# Prediction backend: auto = SAP-RPT-1.6 with automatic fallback to the
# baseline; baseline (or unset) = baseline only.
CLEAR_PREDICTION_BACKEND=auto
CLEAR_RPT_TIMEOUT_SECONDS=15

# Deployment (docs/deployment.md): with the runtime ARN set, the UI runs the
# agents on AgentCore Runtime and reads DynamoDB. scripts/aws_setup.py prints
# the value after `agentcore deploy`.
CLEAR_AGENT_RUNTIME_ARN=
