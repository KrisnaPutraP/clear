# Template only: copy to .env (git-ignored) and fill in locally; docs/setup.md
# says where each value comes from. Never put credentials in this file or
# anywhere else in Git. Empty values are ignored.

# --- The agents' model -------------------------------------------------------
# aicore: Claude Sonnet 4.6 on SAP AI Core (the team's setup).
# bedrock: Amazon Bedrock, with CLEAR_BEDROCK_MODEL_ID and AWS credentials.
CLEAR_LLM_BACKEND=aicore
CLEAR_BEDROCK_MODEL_ID=

# --- SAP AI Core ---------------------------------------------------------------
# The team's AI Core service key. Used for SAP-RPT-1.6 and, with
# CLEAR_LLM_BACKEND=aicore, for the agents' model.
SAP_AICORE_AUTH_URL=
SAP_AICORE_CLIENT_ID=
SAP_AICORE_CLIENT_SECRET=
SAP_AICORE_API_URL=
SAP_AICORE_RESOURCE_GROUP=default
# Deployment IDs from the organizers' SAP BTP instructions.
SAP_RPT_DEPLOYMENT_ID=
SAP_LLM_DEPLOYMENT_ID=

# Resolution-time prediction: auto = SAP-RPT-1.6 with an automatic fallback to
# the baseline median; baseline (or unset) = the baseline only.
CLEAR_PREDICTION_BACKEND=auto
CLEAR_RPT_TIMEOUT_SECONDS=15

# --- AWS: only for the tools on AWS ---------------------------------------------
# A profile signed in with `aws login --profile <name>`; credentials stay in
# ~/.aws, never here.
AWS_PROFILE=
AWS_DEFAULT_REGION=us-west-2
# Agents on this machine, tools behind AgentCore Gateway, data in DynamoDB.
# `python scripts/gateway_env.py` prints these three lines. Leave the URL
# empty to run everything locally on JSON files.
AGENTCORE_GATEWAY_TOOLS_URL=
CLEAR_ACTION_ROLE=
CLEAR_AGENTS_ROLE=
# Agents on AgentCore Runtime instead, which needs Runtime quota the team's
# account does not have; `python scripts/aws_setup.py` prints it after a deploy.
CLEAR_AGENT_RUNTIME_ARN=

# --- SAP Joule: only for the A2A server (scripts/run_joule_agent.py) ---------
# The public URL Joule reaches scripts/run_joule_agent.py at, and the Basic
# credentials of the BTP destination that points to it. Choose your own
# password; leave it empty only while the server is not exposed.
CLEAR_A2A_URL=
CLEAR_A2A_USER=
CLEAR_A2A_PASSWORD=
# The team's Joule key (uaa.clientid, uaa.clientsecret) from the organizers'
# keybroker, for `joule login`.
JOULE_CLIENT_ID=
JOULE_CLIENT_SECRET=

# --- Development only -------------------------------------------------------------
# 1 = click through the UI with a scripted model, no credentials needed.
CLEAR_UI_SCRIPTED=
