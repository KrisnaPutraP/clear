# Template only: copy to .env (git-ignored) and fill in locally.
# Never put credentials in this file or anywhere in Git.

# AWS: name a profile set up with the AWS CLI; keys stay in ~/.aws, not here.
AWS_PROFILE=
# Fixed region for the hackathon account.
AWS_DEFAULT_REGION=us-west-2

# SAP AI Core: values from the team's service key. Used for SAP-RPT-1.6.
SAP_AICORE_AUTH_URL=
SAP_AICORE_CLIENT_ID=
SAP_AICORE_CLIENT_SECRET=
SAP_AICORE_API_URL=
SAP_AICORE_RESOURCE_GROUP=default
SAP_RPT_DEPLOYMENT_ID=
